# Copy to .env and edit. With no .env the stack runs the default simulation: plain HTTP on
# localhost, with a second Keycloak standing in for Entra.
#
# After changing anything here, recreate the stack:  docker compose down -v && docker compose up -d --build
# (On Windows, separate the files in COMPOSE_FILE with ";" instead of ":".)

# --- Mesh mode: HTTPS on a hostname that other devices reach over the VPN or mesh ---------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.mesh.yml
# MIF_HOST=my-mac.netbird.cloud

# --- Real Entra tenant instead of the stand-in (works with or without mesh mode) ---------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.mesh.yml:docker-compose.entra.yml
# ENTRA_TENANT_ID=
# ENTRA_BROKER_CLIENT_ID=
# ENTRA_BROKER_CLIENT_SECRET=
# Optional synthetic sign-in probe: a second app registration with a secret and no permissions.
# ENTRA_PROBE_CLIENT_ID=
# ENTRA_PROBE_CLIENT_SECRET=
