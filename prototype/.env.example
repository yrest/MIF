# With no .env the stack runs the simulation: plain HTTP on localhost, with a second Keycloak
# standing in for Entra.
#
# For the live configuration do not copy this file: run  scripts/init-live.sh <hostname> <bind-address>
# which writes .env with generated secrets.
#
# --- Mesh mode: the simulation over HTTPS, for a second device on the VPN or mesh ---------------
# After changing this, recreate the stack:  docker compose down -v && docker compose up -d --build
# (On Windows, separate the files in COMPOSE_FILE with ";" instead of ":".)
# COMPOSE_FILE=docker-compose.yml:docker-compose.mesh.yml
# MIF_HOST=my-machine.mesh.example
